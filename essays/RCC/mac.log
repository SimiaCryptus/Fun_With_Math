read and interpret /home/andrew/code/Fun_With_Math/essays/RCC/main.mac
(%i2) rcc_fpprec:200
(%i3) fpprec:rcc_fpprec
(%i4) rcc_pi_ref:bfloat(%pi)
(%i5) rcc_e_ref:bfloat(%e)
(%i6) rcc_bits(r):=block([p,q],r:rat(r),p:num(r),q:denom(r),
               if p = 0 then 1
                   else floor(log(abs(p))/log(2))+floor(log(abs(q))/log(2))+2)
(%i7) rcc_intbits(n):=if n <= 0 then 0 else floor(log(n)/log(2))+1
(%i8) rcc_bf(r):=bfloat(r)
(%i9) rcc_abserr(approx,ref):=abs(bfloat(approx)-ref)
(%i10) rcc_eps_ladder(kmax):=makelist(bfloat(10)^-k,k,1,kmax)
(%i11) rcc_linfit(xs,ys):=block([n,sx,sy,sxx,sxy,denom,m,b,i,xi,yi],
                  n:length(xs),sx:0.0,sy:0.0,sxx:0.0,sxy:0.0,
                  for i thru n do
                      (xi:float(xs[i]),yi:float(ys[i]),sx:sx+xi,sy:sy+yi,
                       sxx:sxx+xi*xi,sxy:sxy+xi*yi),denom:n*sxx-sx*sx,
                  if abs(denom) < 1.0E-300 then [0.0,sy/n]
                      else (m:(n*sxy-sx*sy)/denom,b:(sy-m*sx)/n,[m,b]))
(%i12) rcc_linresidual(xs,ys,fit):=block([m,b,s,i],m:fit[1],b:fit[2],s:0.0,
                       for i thru length(xs) do
                           s:s+(float(ys[i])-(m*float(xs[i])+b))^2,s)
(%i13) rcc_r2(xs,ys,fit):=block([m,b,ybar,sstot,ssres,i,n],m:fit[1],b:fit[2],
              n:length(ys),ybar:0.0,for i thru n do ybar:ybar+float(ys[i]),
              ybar:ybar/n,sstot:0.0,ssres:0.0,
              for i thru n do
                  (sstot:sstot+(float(ys[i])-ybar)^2,
                   ssres:ssres+(float(ys[i])-(m*float(xs[i])+b))^2),
              if sstot < 1.0E-300 then 1.0 else 1.0-ssres/sstot)
(%i14) rcc_fit_class(tbl):=block(
                     [L,M,invE,polylogx,fit_log,fit_polylog,fit_loglog,r2_log,
                      r2_polylog,r2_loglog,slope_loglog,i,n,logM,label,
                      detail],n:length(tbl),
                     L:makelist(float(log(1/bfloat(tbl[i][1]))),i,1,n),
                     M:makelist(float(tbl[i][2]),i,1,n),
                     invE:makelist(float(1/bfloat(tbl[i][1])),i,1,n),
                     polylogx:makelist(invE[i]*L[i],i,1,n),
                     logM:makelist(if M[i] > 0 then float(log(M[i])) else 0.0,
                                   i,1,n),fit_log:rcc_linfit(L,M),
                     r2_log:rcc_r2(L,M,fit_log),
                     fit_polylog:rcc_linfit(polylogx,M),
                     r2_polylog:rcc_r2(polylogx,M,fit_polylog),
                     fit_loglog:rcc_linfit(L,logM),
                     r2_loglog:rcc_r2(L,logM,fit_loglog),
                     slope_loglog:fit_loglog[1],
                     if r2_log > 0.999 and abs(slope_loglog) < 0.15
                         then (label:"RC1",
                               detail:sconcat("log-linear R^2=",r2_log,
                                              "  poly-exp~",slope_loglog,
                                              "  (information-theoretically optimal)"))
                         else (if slope_loglog > 1.5
                                   then (if slope_loglog > 3.0
                                             then (label:"RC3",
                                                   detail
                                                    :sconcat("log-log slope=",
                                                             slope_loglog,
                                                             " (super-polynomial growth)"))
                                             else (label:"RC2",
                                                   detail
                                                    :sconcat("log-log slope=",
                                                             slope_loglog,
                                                             " (polynomial, exponent>1)")))
                                   else (if
                                   r2_polylog > r2_log and r2_polylog > 0.99
                                    then (label:"RC2-polylog",
                                          detail
                                           :sconcat("(1/eps)*log(1/eps) R^2=",
                                                    r2_polylog,"  poly-exp~",
                                                    slope_loglog))
                                    else (label:"RC2",
                                          detail
                                           :sconcat(
                                            "log-log slope (poly exponent)=",
                                            slope_loglog,"  log-linear R^2=",
                                            r2_log)))),
                     [label,detail,
                      [["r2_log",r2_log],["r2_polylog",r2_polylog],
                       ["r2_loglog",r2_loglog],["poly_exp",slope_loglog]]])
(%i15) rcc_gl_partial(n):=block([s,k],s:0,
                      for k from 0 thru n-1 do s:s+(-1)^k/(2*k+1),4*s)
(%i16) rcc_gl_errbound(n):=bfloat(4/(2*n+1))
(%i17) rcc_nila_partial(n):=block([s,k],s:3,
                        for k thru n do
                            s:s+((-1)^(k+1)*4)/((2*k)*(2*k+1)*(2*k+2)),s)
(%i18) rcc_nila_errbound(n):=bfloat(4/((2*(n+1))*(2*(n+1)+1)*(2*(n+1)+2)))
(%i19) rcc_wallis_partial(n):=block([p,k],p:2,
                          for k thru n do p:(p*(2*k)^2)/((2*k-1)*(2*k+1)),p)
(%i20) rcc_wallis_errbound(n):=bfloat(%pi/(4*n))
(%i21) rcc_binom_partial(kk,n):=block([s,m,rho],rho:1-1/kk,s:0,
                         for m from 0 thru n-1 do
                             s:s+(binomial(2*m,m)/4^m)*rho^m,s)
(%i22) rcc_binom_errbound(kk,n):=block([rho],rho:bfloat(1-1/kk),bfloat(kk)
                                                                 *rho^n)
(%i23) rcc_e_partial(n):=block([s,m],s:0,for m from 0 thru n-1 do s:s+1/m!,s)
(%i24) rcc_e_errbound(n):=if n < 1 then bfloat(3) else bfloat(3/n!)
(%i25) rcc_engine_ref(name):=if name = "binom2" then bfloat(sqrt(2))
                       elseif name = "binom3" then bfloat(sqrt(3))
                       elseif name = "binom5" then bfloat(sqrt(5))
                       elseif name = "binom10" then bfloat(sqrt(10))
                       elseif name = "e" then rcc_e_ref else rcc_pi_ref
(%i26) rcc_engine_partial(name,n):=if name = "gl" then rcc_gl_partial(n)
                           elseif name = "nila" then rcc_nila_partial(n)
                           elseif name = "wallis" then rcc_wallis_partial(n)
                           elseif name = "binom2" then rcc_binom_partial(2,n)
                           elseif name = "binom3" then rcc_binom_partial(3,n)
                           elseif name = "binom5" then rcc_binom_partial(5,n)
                           elseif name = "binom10"
                           then rcc_binom_partial(10,n) elseif name = "e"
                           then rcc_e_partial(n)
                           else error("unknown engine",name)
(%i27) rcc_engine_errbound(name,n):=if name = "gl" then rcc_gl_errbound(n)
                            elseif name = "nila" then rcc_nila_errbound(n)
                            elseif name = "wallis" then rcc_wallis_errbound(n)
                            elseif name = "binom2"
                            then rcc_binom_errbound(2,n)
                            elseif name = "binom3"
                            then rcc_binom_errbound(3,n)
                            elseif name = "binom5"
                            then rcc_binom_errbound(5,n)
                            elseif name = "binom10"
                            then rcc_binom_errbound(10,n) elseif name = "e"
                            then rcc_e_errbound(n)
                            else error("unknown engine",name)
(%i28) rcc_engine_predicted(name):=if name = "gl" then "RC2"
                             elseif name = "nila" then "RC2"
                             elseif name = "wallis" then "RC2-polylog"
                             elseif name = "e" then "RC1" else "RC1"
(%i29) rcc_engine_pretty(name):=if name = "gl" then "Gregory-Leibniz (pi)"
                          elseif name = "nila" then "Nilakantha (pi)"
                          elseif name = "wallis" then "Wallis product (pi)"
                          elseif name = "binom2"
                          then "Binomial series sqrt(2)"
                          elseif name = "binom3"
                          then "Binomial series sqrt(3)"
                          elseif name = "binom5"
                          then "Binomial series sqrt(5)"
                          elseif name = "binom10"
                          then "Binomial series sqrt(10)" elseif name = "e"
                          then "Taylor series (e)" else name
(%i30) rcc_all_engines:["gl","nila","wallis","binom2","binom3","binom5",
                        "binom10","e"]
(%i31) rcc_find_N(name,eps):=block([n,bnd,stp,guard],n:1,stp:1,guard:0,
                  while rcc_engine_errbound(name,n) >= eps and guard < 200 do
                        (n:n+stp,stp:stp*2,guard:guard+1),
                  block([lo,hi,mid],lo:max(1,floor(n/2)),hi:n,
                        while lo < hi do
                              (mid:floor((lo+hi)/2),
                               if rcc_engine_errbound(name,mid) < eps
                                   then hi:mid else lo:mid+1),lo))
(%i32) rcc_sweep(name,kmax):=block([ladder,rows,eps,N,S,b],
                 ladder:rcc_eps_ladder(kmax),rows:[],
                 for eps in ladder do
                     (N:rcc_find_N(name,eps),S:rcc_engine_partial(name,N),
                      b:rcc_bits(rat(S)),rows:append(rows,[[eps,N,b]])),rows)
(%i33) rcc_verify_bounds(name,Nlist):=block([ref,ok,n,S,err,bnd,fails],
                         ref:rcc_engine_ref(name),ok:true,fails:[],
                         for n in Nlist do
                             (S:rcc_engine_partial(name,n),
                              err:rcc_abserr(S,ref),
                              bnd:rcc_engine_errbound(name,n),
                              if err > bnd
                                  then (ok:false,
                                        fails:append(fails,[[n,err,bnd]]))),
                         [ok,fails])
(%i34) rcc_lcm_upto(M):=block([L,i],L:1,for i from 2 thru M do L:lcm(L,i),L)
(%i35) rcc_psi(M):=float(log(rcc_lcm_upto(M)))
(%i36) rcc_odd_lcm_log(N):=block([L,k],L:1,
                       for k from 0 thru N do L:lcm(L,2*k+1),float(log(L)))
(%i37) rcc_triple_lcm_log(N):=block([L,k],L:1,
                          for k thru N do L:lcm(L,(2*k)*(2*k+1)*(2*k+2)),
                          float(log(L)))
(%i38) rcc_wallis_den_log(N):=block([s,k],s:0.0,
                          for k thru N do s:s+float(log((2*k-1)*(2*k+1))),s)
(%i39) rcc_report_chebyshev(maxM,stepM):=block([M,ratio,rows],rows:[],
                            print("  --- G3.1  Chebyshev psi(M) = log lcm(1..M),  expect psi(M)/M -> 1 ---"),
                            M:stepM,
                            while M <= maxM do
                                  (ratio:rcc_psi(M)/M,
                                   print(
                                    sconcat("    M=",M,"   psi(M)=",
                                            rcc_psi(M),"   psi(M)/M=",ratio)),
                                   rows:append(rows,[[M,ratio]]),M:M+stepM),
                            rows)
(%i40) rcc_report_den_growth(name,Nlist):=block([n,S,db,naive,tight,rows],
                             rows:[],
                             print(sconcat(
                                    "  --- G3.2  Denominator growth for ",
                                    rcc_engine_pretty(name),
                                    " : actual reduced-denominator bits vs N and N*log2(N) ---")),
                             for n in Nlist do
                                 (S:rat(rcc_engine_partial(name,n)),
                                  db:rcc_intbits(abs(denom(S))),
                                  naive:float((n*log(n))/log(2)),
                                  tight:float(n),
                                  print(
                                   sconcat("    N=",n,"   den-bits=",db,
                                           "   N=",tight,"   N*log2(N)=",
                                           naive,"   ratio(db/N)=",
                                           float(db/max(1,n)))),
                                  rows:append(rows,[[n,db,tight,naive]])),
                             rows)
(%i41) rcc_classify_N(sweep_rows):=block([tbl],
                      tbl:makelist([sweep_rows[i][1],sweep_rows[i][2]],i,1,
                                   length(sweep_rows)),rcc_fit_class(tbl))
(%i42) rcc_classify_bits(sweep_rows):=block([tbl],
                         tbl:makelist([sweep_rows[i][1],sweep_rows[i][3]],i,1,
                                      length(sweep_rows)),rcc_fit_class(tbl))
(%i43) rcc_wallis_vs_gl(kmax):=block([gl,wl,i,n],gl:rcc_sweep("gl",kmax),
                        wl:rcc_sweep("wallis",kmax),
                        print("  --- G4.2  Wallis vs Gregory-Leibniz: bits-vs-eps side by side ---"),
                        print("    eps          GL:N      GL:bits     Wallis:N    Wallis:bits   ratio(W/GL bits)"),
                        n:min(length(gl),length(wl)),
                        for i thru n do
                            print(sconcat("    ",float(gl[i][1]),"   ",
                                          gl[i][2],"   ",gl[i][3],"      ",
                                          wl[i][2],"   ",wl[i][3],"    ",
                                          float(wl[i][3]/max(1,gl[i][3])))),
                        [gl,wl])
(%i44) rcc_wallis_rc2_check(kmax,delta):=block([wl,i,eps,bits,val,rows],
                            wl:rcc_sweep("wallis",kmax),rows:[],
                            print(sconcat(
                                   "  --- G4.3  Wallis RC2 check: bits / ((1/eps)^(1+delta)) -> 0, delta=",
                                   float(delta)," ---")),
                            for i thru length(wl) do
                                (eps:wl[i][1],bits:wl[i][3],
                                 val:float(bits/(1/bfloat(eps))^(1+delta)),
                                 print(sconcat("    eps=",float(eps),
                                               "   bits=",bits,
                                               "   bits/(1/eps)^(1+delta)=",
                                               val)),
                                 rows:append(rows,[[eps,val]])),
                            print("    (decreasing toward 0 confirms Wallis is RC2, not RC3.)"),
                            rows)
(%i45) rcc_floor_check(name,kmax):=block([sw,i,eps,bits,floorbits,ok,rows],
                       sw:rcc_sweep(name,kmax),ok:true,rows:[],
                       for i thru length(sw) do
                           (eps:sw[i][1],bits:sw[i][3],
                            floorbits:float(log(1/bfloat(eps))/log(2)),
                            if bits < floorbits then ok:false,
                            rows:append(rows,[[eps,bits,floorbits]])),
                       [ok,rows])
(%i46) rcc_saturation_check(name,kmax):=block([sw,i,eps,bits,floorbits,ratio,
                                               rows],sw:rcc_sweep(name,kmax),
                            rows:[],
                            print(sconcat("  --- G5.2  Saturation for ",
                                          rcc_engine_pretty(name),
                                          ": bits/log2(1/eps) -> const (RC1 optimality) ---")),
                            for i thru length(sw) do
                                (eps:sw[i][1],bits:sw[i][3],
                                 floorbits:float(log(1/bfloat(eps))/log(2)),
                                 ratio:float(bits/max(1.0,floorbits)),
                                 print(sconcat("    eps=",float(eps),
                                               "   bits=",bits,
                                               "   log2(1/eps)=",floorbits,
                                               "   ratio=",ratio)),
                                 rows:append(rows,[[eps,ratio]])),rows)
(%i47) rcc_is_rational_in(expr,var):=block([r],r:ratsimp(expr),
                          polynomialp(num(r),[var])
                            and polynomialp(denom(r),[var]))
(%i48) rcc_hypergeometric_check(termexpr,n):=block([ratio],
                                ratio:ratsimp(
                                      subst(n = n+1,termexpr)/termexpr),
                                [rcc_is_rational_in(ratio,n),ratio])
(%i49) rcc_report_hypergeometric():=block([res,kk],
                                 print("  --- G6.1  Hypergeometric term-ratio rationality checks ---"),
                                 res:rcc_hypergeometric_check(
                                     (-1)^n/(2*n+1),n),
                                 print(sconcat(
                                        "    Gregory-Leibniz   hypergeometric? ",
                                        res[1],"   ratio=",res[2])),
                                 res:rcc_hypergeometric_check(
                                     ((-1)^(n+1)*4)/((2*n)*(2*n+1)*(2*n+2)),
                                     n),
                                 print(sconcat(
                                        "    Nilakantha        hypergeometric? ",
                                        res[1],"   ratio=",res[2])),
                                 res:rcc_hypergeometric_check(
                                     (2*n)^2/((2*n-1)*(2*n+1)),n),
                                 print(sconcat(
                                        "    Wallis (factor)   hypergeometric? ",
                                        res[1],"   ratio=",res[2])),
                                 res:rcc_hypergeometric_check(
                                     (binomial(2*n,n)/4^n)*rho^n,n),
                                 print(sconcat(
                                        "    Binomial sqrt(k)  hypergeometric? ",
                                        res[1],"   ratio=",res[2])),
                                 res:rcc_hypergeometric_check(1/n!,n),
                                 print(sconcat(
                                        "    Taylor e          hypergeometric? ",
                                        res[1],"   ratio=",res[2])),'done)
(%i50) rcc_report_agm_negative():=block([ratio,israt],
                               print("  --- G6.2  AGM negative test: term ratio involves sqrt (NOT rational) ---"),
                               ratio:ratsimp(sqrt(a*b)/b),
                               israt:freeof(sqrt,ratify_safe(ratio)),
                               print(sconcat(
                                      "    AGM step b_{n+1}/b_n = sqrt(a*b)/b = ",
                                      ratio)),
                               print("    This ratio depends on sqrt(a/b): NOT a rational function of the index."),
                               print("    => AGM is excluded from the hypergeometric class (essay's claim)."),
                               'done)
(%i51) ratify_safe(e):=e
(%i52) rcc_cbrt_binom_partial(target,x,n):=block([s,m,coeff,j],s:0,
                              for m from 0 thru n-1 do
                                  (coeff:1,
                                   for j from 0 thru m-1 do
                                       coeff:(coeff*((-1)/3-j))/(j+1),
                                   s:s+coeff*(-x)^m),s)
(%i53) rcc_cbrt2_partial(n):=rcc_cbrt_binom_partial(2,1/2,n)
(%i54) rcc_cbrt2_errbound(n):=bfloat(3*(1/2)^n)
(%i55) rcc_report_gauss_spotcheck(kmax):=block(
                                  [eps,N,S,b,ref,floorbits,ratio,ladder,rows],
                                  print(
                                   "  --- G6.3  Gauss spot check: 2^(1/3) via binomial(-1/3) series ---"),
                                  ref:bfloat(2^(1/3)),
                                  ladder:rcc_eps_ladder(kmax),rows:[],
                                  for eps in ladder do
                                      (N:1,
                                       while rcc_cbrt2_errbound(N) >= eps do
                                             N:N+1,S:rcc_cbrt2_partial(N),
                                       b:rcc_bits(rat(S)),
                                       floorbits
                                        :float(log(1/bfloat(eps))/log(2)),
                                       ratio:float(b/max(1.0,floorbits)),
                                       print(
                                        sconcat("    eps=",float(eps),"   N=",
                                                N,"   bits=",b,
                                                "   log2(1/eps)=",floorbits,
                                                "   ratio=",ratio)),
                                       rows:append(rows,[[eps,N,b]])),
                                  print(
                                   "    Bits track log2(1/eps): supports RC1 for algebraic 2^(1/3)."),
                                  rcc_classify_bits(rows))
(%i56) rcc_agm_pi(iters):=block([a,b,t,p,i,an,prevpi,piapprox,prec],
                  fpprec:rcc_fpprec,a:bfloat(1),b:bfloat(1/sqrt(2)),
                  t:bfloat(1/4),p:bfloat(1),piapprox:bfloat(0),
                  for i thru iters do
                      (an:(a+b)/2,b:sqrt(a*b),t:t-p*(a-an)^2,a:an,p:2*p),
                  piapprox:(a+b)^2/(4*t),piapprox)
(%i57) rcc_report_agm_pi(maxiters):=block([i,papprox,err,bits_est,rrat,rows],
                         print("  --- G7.1  AGM (Gauss-Legendre) for pi: quadratic convergence, RC1 ---"),
                         print("    iters    |pi - approx|         ~achieved bits (log2(1/err))"),
                         rows:[],
                         for i thru maxiters do
                             (papprox:rcc_agm_pi(i),
                              err:rcc_abserr(papprox,rcc_pi_ref),
                              bits_est:if err <= 0
                                           then float(
                                           (rcc_fpprec*log(10))/log(2))
                                           else float(log(1/err)/log(2)),
                              print(sconcat("    ",i,"      ",err,"     ",
                                            bits_est)),
                              rows:append(rows,[[err,i]])),
                         print("    Error squares each step (doubling correct digits) => RC1 outside"),
                         print("    the hypergeometric class, confirming the essay's collapse caveat."),
                         rows)
(%i58) rcc_ramanujan_recip_partial(n):=block([s,m],s:0,
                                   for m from 0 thru n-1 do
                                       s
                                       :s
                                        +((4*m)!*(1103+26390*m))
                                         /(m!^4*396^(4*m)),s)
(%i59) rcc_report_ramanujan_probe(maxN):=block([n,S,b,rows],
                                  print(
                                   "  --- G7.2  Open-question probe: Ramanujan fast hypergeometric pi-series ---"),
                                  print(
                                   "    Per-term convergence ~10^-8/term (few terms suffice), but naive"),
                                  print(
                                   "    common-denominator bit-length grows fast. N -> reduced-core bits:"),
                                  rows:[],
                                  for n thru maxN do
                                      (S:rat(rcc_ramanujan_recip_partial(n)),
                                       b:rcc_bits(S),
                                       print(
                                        sconcat("    N=",n,"   core-bits=",
                                                b)),
                                       rows:append(rows,[[n,b]])),
                                  print(
                                   "    Bit-length per term grows ~ linearly in N while N(eps)~log(1/eps);"),
                                  print(
                                   "    naive summation therefore does NOT reach RC1 — binary-splitting would."),
                                  print(
                                   "    Heuristic verdict (low confidence): no naive-hypergeometric RC1 engine"),
                                  print(
                                   "    for pi found; consistent with the essay's OPEN question."),
                                  rows)
(%i60) rcc_export_benchmark(filename,kmax):=block([stream,name,sw,i,line],
                            stream:openw(filename),
                            printf(stream,"engine,predicted_rc,eps,N,bits~%"),
                            for name in rcc_all_engines do
                                (sw:rcc_sweep(name,kmax),
                                 for i thru length(sw) do
                                     printf(stream,"~a,~a,~a,~a,~a~%",
                                            rcc_engine_pretty(name),
                                            rcc_engine_predicted(name),
                                            float(sw[i][1]),sw[i][2],
                                            sw[i][3])),close(stream),
                            print(sconcat(
                                   "  --- G7.3  Benchmark suite written to ",
                                   filename," ---")),'done)
(%i61) rcc_engine_hypergeometric(name):=block([res],
                                 if name = "gl"
                                     then res
                                     :rcc_hypergeometric_check(
                                      (-1)^n/(2*n+1),n) elseif name = "nila"
                                     then res
                                     :rcc_hypergeometric_check(
                                      ((-1)^(n+1)*4)/((2*n)*(2*n+1)*(2*n+2)),
                                      n) elseif name = "wallis"
                                     then res
                                     :rcc_hypergeometric_check(
                                      (2*n)^2/((2*n-1)*(2*n+1)),n)
                                     elseif name = "e"
                                     then res:rcc_hypergeometric_check(1/n!,n)
                                     else res
                                     :rcc_hypergeometric_check(
                                      (binomial(2*n,n)/4^n)*rho^n,n),res[1])
(%i62) rcc_verdict(measured,predicted):=block([norm_m,norm_p],
                   norm_m:if measured = "RC2-polylog" then "RC2"
                              else measured,
                   norm_p:if predicted = "RC2-polylog" then "RC2"
                              else predicted,
                   if norm_m = norm_p then "AGREE"
                       else sconcat("DISAGREE (measured=",measured,
                                    ", predicted=",predicted,")"))
(%i63) rcc_report_engine(name,kmax):=block([sw,hyp,ncls,bcls,pred,verdict,
                                            bndres],sw:rcc_sweep(name,kmax),
                         hyp:rcc_engine_hypergeometric(name),
                         ncls:rcc_classify_N(sw),bcls:rcc_classify_bits(sw),
                         pred:rcc_engine_predicted(name),
                         verdict:rcc_verdict(bcls[1],pred),
                         bndres:rcc_verify_bounds(name,
                                                  makelist(sw[i][2],i,1,
                                                           length(sw))),
                         print("  ----------------------------------------------------------"),
                         print(sconcat("  ENGINE: ",rcc_engine_pretty(name))),
                         print(sconcat("    hypergeometric?       ",hyp)),
                         print(sconcat("    rigorous bounds hold?  ",
                                       bndres[1])),
                         print(sconcat("    measured N(eps) class: ",ncls[1],
                                       "   [",ncls[2],"]")),
                         print(sconcat("    measured bits class:   ",bcls[1],
                                       "   [",bcls[2],"]")),
                         print(sconcat("    predicted RC class:    ",pred)),
                         print(sconcat("    VERDICT:               ",
                                       verdict)),
                         [name,hyp,ncls[1],bcls[1],pred,verdict])
(%i64) rcc_run_all([opts]):=block([kmax,summary,name,ssize,denN],
                   kmax:if length(opts) >= 1 then opts[1] else 6,
                   ssize:if length(opts) >= 2 then opts[2] else 14,
                   print("=============================================================="),
                   print("  RATIONAL CERTIFICATE COMPLEXITY (RCC) — COMPANION REPORT"),
                   print(sconcat("  tolerance ladder: eps = 10^-1 ... 10^-",
                                 kmax)),
                   print("=============================================================="),
                   print(""),
                   print("== Section 6: Hypergeometric Regularity Condition =="),
                   rcc_report_hypergeometric(),rcc_report_agm_negative(),
                   rcc_report_gauss_spotcheck(min(kmax,8)),print(""),
                   print("== Section 3: Denominator-Growth Verification (PNT step) =="),
                   rcc_report_chebyshev(60,10),denN:[4,8,16,32,64],
                   rcc_report_den_growth("gl",denN),
                   print(sconcat("  --- G3.3  Nilakantha triple-product lcm (expect Theta(N)) ---")),
                   for n in denN do
                       print(sconcat("    N=",n,"   log lcm(triples)=",
                                     rcc_triple_lcm_log(n),"   ratio/N=",
                                     float(rcc_triple_lcm_log(n)/n))),
                   print(sconcat("  --- G3.4  Wallis denominator log (expect ~ N log N) ---")),
                   for n in denN do
                       print(sconcat("    N=",n,"   log den=",
                                     rcc_wallis_den_log(n),
                                     "   ratio/(N log N)=",
                                     float(
                                      rcc_wallis_den_log(n)
                                       /max(1,n*log(n))))),print(""),
                   print("== Section 2/4/8: Per-Engine Sweep, Classification & Verdicts =="),
                   summary:[],
                   for name in rcc_all_engines do
                       summary:append(summary,[rcc_report_engine(name,kmax)]),
                   print(""),print("== Section 4: Headline Distinctions =="),
                   rcc_wallis_vs_gl(kmax),rcc_wallis_rc2_check(kmax,1/4),
                   print(""),
                   print("== Section 5: Optimality / Information-Theoretic Floor =="),
                   block([fc],fc:rcc_floor_check("gl",kmax),
                         print(sconcat("  G5.1  GL respects floor (bits >= log2(1/eps))? ",
                                       fc[1])),
                         fc:rcc_floor_check("binom2",kmax),
                         print(sconcat("  G5.1  binom2 respects floor? ",
                                       fc[1]))),
                   rcc_saturation_check("binom2",kmax),print(""),
                   print("== Section 7: Stretch / Research-Facing =="),
                   rcc_report_agm_pi(7),rcc_report_ramanujan_probe(6),
                   rcc_export_benchmark("rcc_benchmark.csv",kmax),print(""),
                   print("== FINAL SUMMARY (Reporting Contract, G8) =="),
                   print("  engine | hyper? | N(eps) class | bits class | predicted | verdict"),
                   for row in summary do
                       print(sconcat("  ",row[1]," | ",row[2]," | ",row[3],
                                     " | ",row[4]," | ",row[5]," | ",row[6])),
                   print("=============================================================="),
                   print("  Discrepancies (DISAGREE) are the headline output: informative,"),
                   print("  not invalidating — exactly as the essay frames them."),
                   print("=============================================================="),
                   summary)
(%i65) rcc_run_all(6,14)

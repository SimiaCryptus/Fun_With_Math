/* =====================================================================
   pinwheels.mac

   Maxima analysis and computational experiments for:
   "Pinwheel Polygons and Edge-Restricted Reconnection"

   This file implements the edge-restriction framework of pinwheels.md,
   in which a polygon's expansion family is generated by a strict
   *subset* E_A of its edges (the "active" edges), while the remaining
   edges E_I = E \ E_A are either inactive (pure boundary) or carry a
   controlled "weak" generator that acts as a sheet-transition holonomy.

   The canonical example is the Conway-Radin pinwheel triangle (legs
   1 and 2, hypotenuse sqrt(5)).  Its full orientation group is dense
   in O(2), so the *full* expansion family fails Criterion 1 of
   affine.md (it is non-reconnective at Level 3).  But restricting to
   the two perpendicular legs gives an orientation group Z_2 x Z_2
   (Klein four-group), which IS finite -- so the restricted family is
   reconnective at Level 2.  Adding the hypotenuse as a sheet-shift
   generator promotes the structure to a multi-sheeted cover of the
   Z^2 lattice with controllable spectral dimension in (2, 3).

   This file does the following experiments:

   Sections:
     0.  Configuration and parameter setup
     1.  Field arithmetic helpers (Q, Q(sqrt(d)))
     2.  Pinwheel triangle geometry (Conway-Radin)
     3.  Orientation group analysis (full vs restricted)
     4.  Adjacency graph construction (edge-restricted BFS)
     5.  Graph Laplacian and spectral gap
     6.  BFS volume growth and d_eff estimation
     7.  Random walk and d_w, d_spec estimation
     8.  Sheet-transition (weak generator) variants
     9.  Half-Penrose kite / dart pinwheel
    10.  Right triangle (1, sqrt(3)) targeting triangular lattice
    11.  L-tromino (Level 2 with trivial fiber)
    12.  Cross-polygon comparison and dimensional hierarchy
    13.  Summary report

   The construction is parameterized by:
     - POLY_TYPE       : which pinwheel polygon to build
                         ("CR_triangle", "tri_1_sqrt3", "L_tromino",
                          "half_penrose_kite", "half_penrose_dart")
     - ACTIVE_MODE     : which edge-restriction to apply
                         ("legs_only"   -- active = perpendicular legs,
                          "with_hyp"    -- active = legs + hypotenuse,
                                            hypotenuse drives sheet shift,
                          "all_edges"   -- active = all edges, no
                                            restriction; reproduces the
                                            full (often non-reconnective)
                                            family)
     - BFS_DEPTH       : depth of expansion
     - FIBER_ORDER     : modulus for sheet group (Z_n) when applicable
   ===================================================================== */

if not(?boundp('display2d)) then display2d : false$

print("============================================================")$
print("pinwheels.mac : Pinwheel Polygons and Edge-Restricted")$
print("                Reconnection")$
print("============================================================")$

/* Reproducible RNG. */
if ?fboundp('make_random_state) then
    set_random_state(make_random_state(20250115))
else
    print("(note: make_random_state unavailable; using default RNG)")$

/* =====================================================================
   SECTION 0.  CONFIGURATION
   ===================================================================== */

/* Which polygon family.  Defaults to Conway-Radin triangle, the
   canonical pinwheel of pinwheels.md Section 2.1. */
POLY_TYPE : "CR_triangle" $
if ?boundp('PINWHEEL_POLY_OVERRIDE) then
    POLY_TYPE : PINWHEEL_POLY_OVERRIDE $

/* Which edges are active. */
ACTIVE_MODE : "legs_only" $
if ?boundp('PINWHEEL_ACTIVE_OVERRIDE) then
    ACTIVE_MODE : PINWHEEL_ACTIVE_OVERRIDE $

/* Computational cost knobs. */
EXPERIMENT_PRESET : "small" $
if ?boundp('PINWHEEL_PRESET_OVERRIDE) then
    EXPERIMENT_PRESET : PINWHEEL_PRESET_OVERRIDE $

if EXPERIMENT_PRESET = "tiny" then (
    BFS_DEPTH : 2,
    M_WALKS   : 50,
    T_STEPS   : 10,
    EIG_MAX_N : 600
) elseif EXPERIMENT_PRESET = "small" then (
    BFS_DEPTH : 3,
    M_WALKS   : 200,
    T_STEPS   : 30,
    EIG_MAX_N : 1000
) elseif EXPERIMENT_PRESET = "medium" then (
    BFS_DEPTH : 4,
    M_WALKS   : 1000,
    T_STEPS   : 80,
    EIG_MAX_N : 1500
) elseif EXPERIMENT_PRESET = "large" then (
    BFS_DEPTH : 5,
    M_WALKS   : 5000,
    T_STEPS   : 200,
    EIG_MAX_N : 2000
) else error("Unknown EXPERIMENT_PRESET: ", EXPERIMENT_PRESET) $

/* Fiber group order for sheet transitions.  For the Conway-Radin
   pinwheel with hypotenuse active, the natural fiber is Z (infinite)
   generated by the Gaussian rotation (3+4i)/5; we truncate it to
   Z_FIBER_ORDER to make BFS finite. */
FIBER_ORDER : 8 $
if ?boundp('PINWHEEL_FIBER_OVERRIDE) then
    FIBER_ORDER : PINWHEEL_FIBER_OVERRIDE $

print("Configuration:")$
print("  POLY_TYPE         =", POLY_TYPE)$
print("  ACTIVE_MODE       =", ACTIVE_MODE)$
print("  EXPERIMENT_PRESET =", EXPERIMENT_PRESET)$
print("  BFS_DEPTH         =", BFS_DEPTH)$
print("  M_WALKS           =", M_WALKS)$
print("  T_STEPS           =", T_STEPS)$
print("  FIBER_ORDER       =", FIBER_ORDER)$

/* Shared least-squares slope/intercept fit. */
log_log_fit(xs, ys) := block(
    [n : length(xs), sx, sy, sxx, sxy, slope, intercept, denom],
    if n < 2 then return([0.0, 0.0]),
    sx  : apply("+", xs),
    sy  : apply("+", ys),
    sxx : apply("+", xs*xs),
    sxy : apply("+", xs*ys),
    denom : n*sxx - sx^2,
    if abs(float(denom)) < 1e-15 then return([0.0, float(sy/n)]),
    slope     : (n*sxy - sx*sy)/denom,
    intercept : (sy - slope*sx)/n,
    [float(slope), float(intercept)]) $

/* =====================================================================
   SECTION 1.  FIELD ARITHMETIC
   ---------------------------------------------------------------------
   For the CR triangle we work over Q (legs are integer-length).  For
   the half-Penrose kite/dart we work over Q(sqrt(5)) (= Z[phi]).  For
   the triangular-lattice pinwheel we work over Q(sqrt(3)).

   For simplicity all coordinates are stored as Maxima expressions
   that ratsimp/radcan to canonical form; equality is tested by
   ratsimp(a - b) = 0.
   ===================================================================== */

/* Canonicalize an algebraic number.  We expand, ratsimp, and radcan
   to bring sqrt-expressions to a normal form. */
qcanon(z) := ratsimp(radcan(expand(z))) $
qeq(a, b) := is(qcanon(a - b) = 0) $

/* Golden ratio (used by half-Penrose variants). */
phi : (1 + sqrt(5))/2 $

print("Section 1: field arithmetic primitives loaded.")$

/* =====================================================================
   SECTION 2.  PINWHEEL TRIANGLE GEOMETRY
   ---------------------------------------------------------------------
   We define each polygon by:
     - vertex_offsets : list of n vertices [x,y] relative to the cell
                        reference point, in CCW order, with the cell
                        in its canonical orientation.
     - edge_labels    : list of length n, labelling each edge for use
                        in the active-set filter.  Edge k goes from
                        vertex k to vertex k+1 (mod n).
     - edge_active    : list of length n; true if edge is active under
                        the current ACTIVE_MODE.
     - edge_weak      : list of length n; true if edge carries a weak
                        (sheet-shift) generator under the current mode.

   The "canonical orientation" of a Conway-Radin triangle places the
   right angle at the origin, leg 1 along +x, leg 2 along +y, and the
   hypotenuse going from (1,0) to (0,2).
   ===================================================================== */

/* Polygon data dispatch.  Each entry returns a list:
       [vertex_offsets, edge_labels, n_edges, fld_name].
   The orientation-action group also depends on POLY_TYPE; we record
   it via the reflection-across-edge formulas in Section 3. */

if POLY_TYPE = "CR_triangle" then (
    poly_vertices : [[0, 0], [1, 0], [0, 2]],
    poly_edges    : ["leg1", "hyp", "leg2"],
    poly_field    : "Q"
) elseif POLY_TYPE = "tri_1_sqrt3" then (
    /* Right triangle with legs 1 and sqrt(3); a "30-60-90" piece.
       Two perpendicular legs make Z_2 x Z_2; the hypotenuse of length
       2 carries a 60-degree rotation in the orientation group. */
    poly_vertices : [[0, 0], [1, 0], [0, sqrt(3)]],
    poly_edges    : ["leg1", "hyp", "leg2"],
    poly_field    : "Q(sqrt(3))"
) elseif POLY_TYPE = "L_tromino" then (
    /* L-tromino: three unit squares glued.  Three "long" edges of
       length 2 and three "short" edges of length 1.  Active = long. */
    poly_vertices : [[0, 0], [2, 0], [2, 1], [1, 1], [1, 2], [0, 2]],
    poly_edges    : ["long_b", "short_r1", "long_t1",
                     "short_r2", "long_t2", "short_l"],
    poly_field    : "Q"
) elseif POLY_TYPE = "half_penrose_kite" then (
    /* Half-Penrose kite: triangle with sides 1, phi, phi.  Two long
       edges (phi) are active; short edge (1) carries weak generator. */
    poly_vertices : [[0, 0], [1, 0],
                     [qcanon((1 + phi*cos(2*%pi/5))/2),
                      qcanon(phi*sin(2*%pi/5)/2)]],
    poly_edges    : ["short", "long1", "long2"],
    poly_field    : "Q(sqrt(5))"
) elseif POLY_TYPE = "half_penrose_dart" then (
    poly_vertices : [[0, 0], [1, 0],
                     [qcanon((1 + cos(2*%pi/5)/phi)/2),
                      qcanon(sin(2*%pi/5)/(2*phi))]],
    poly_edges    : ["long", "short1", "short2"],
    poly_field    : "Q(sqrt(5))"
) else error("Unknown POLY_TYPE: ", POLY_TYPE) $

n_edges_poly : length(poly_edges) $

print("Section 2: polygon '", POLY_TYPE, "' loaded.")$
print("  vertices =", poly_vertices)$
print("  edges    =", poly_edges)$
print("  field    =", poly_field)$
print("  n_edges  =", n_edges_poly)$

/* Compute edge endpoints from a vertex list. */
edge_endpoints(verts, k) := block(
    [n : length(verts), v1, v2],
    v1 : verts[mod(k - 1, n) + 1],
    v2 : verts[mod(k, n)     + 1],
    [v1, v2]) $

/* Edge length squared. */
edge_len_sq(verts, k) := block(
    [pp : edge_endpoints(verts, k), dx, dy],
    dx : qcanon(pp[2][1] - pp[1][1]),
    dy : qcanon(pp[2][2] - pp[1][2]),
    qcanon(dx^2 + dy^2)) $

print("  edge length-squareds:")$
for k : 1 thru n_edges_poly do
    print("    e", k, "(", poly_edges[k], ") :", edge_len_sq(poly_vertices, k))$

/* =====================================================================
   SECTION 3.  ACTIVE/INACTIVE PARTITION
   ---------------------------------------------------------------------
   Given POLY_TYPE and ACTIVE_MODE, decide which edges are "active"
   (full generator), "weak" (sheet-shift generator), or "inactive"
   (no neighbor produced).
   ===================================================================== */

/* Default: every edge inactive, then turn on by mode. */
edge_active : makelist(false, k, 1, n_edges_poly) $
edge_weak   : makelist(false, k, 1, n_edges_poly) $

if POLY_TYPE = "CR_triangle" then (
    if ACTIVE_MODE = "legs_only" then (
        edge_active[1] : true,   /* leg1 */
        edge_active[3] : true    /* leg2 */
    ) elseif ACTIVE_MODE = "with_hyp" then (
        edge_active[1] : true,
        edge_active[3] : true,
        edge_weak[2]   : true    /* hyp as weak generator */
    ) elseif ACTIVE_MODE = "all_edges" then (
        edge_active[1] : true,
        edge_active[2] : true,
        edge_active[3] : true
    ) else error("Bad ACTIVE_MODE for CR_triangle: ", ACTIVE_MODE)
) elseif POLY_TYPE = "tri_1_sqrt3" then (
    if ACTIVE_MODE = "legs_only" then (
        edge_active[1] : true,
        edge_active[3] : true
    ) elseif ACTIVE_MODE = "with_hyp" then (
        edge_active[1] : true,
        edge_active[3] : true,
        edge_weak[2]   : true
    ) else (
        edge_active[1] : true,
        edge_active[2] : true,
        edge_active[3] : true)
) elseif POLY_TYPE = "L_tromino" then (
    if ACTIVE_MODE = "long_only" or ACTIVE_MODE = "legs_only" then (
        /* legs_only alias for compatibility */
        edge_active[1] : true,
        edge_active[3] : true,
        edge_active[5] : true
    ) else
        for k : 1 thru n_edges_poly do edge_active[k] : true
) elseif POLY_TYPE = "half_penrose_kite" then (
    if ACTIVE_MODE = "legs_only" then (
        edge_active[2] : true,   /* long1 */
        edge_active[3] : true    /* long2 */
    ) elseif ACTIVE_MODE = "with_hyp" then (
        edge_active[2] : true,
        edge_active[3] : true,
        edge_weak[1]   : true    /* short edge -> Z_5 sheet shift */
    ) else (
        edge_active[1] : true,
        edge_active[2] : true,
        edge_active[3] : true)
) elseif POLY_TYPE = "half_penrose_dart" then (
    if ACTIVE_MODE = "legs_only" then (
        edge_active[2] : true,
        edge_active[3] : true
    ) elseif ACTIVE_MODE = "with_hyp" then (
        edge_active[2] : true,
        edge_active[3] : true,
        edge_weak[1]   : true
    ) else (
        edge_active[1] : true,
        edge_active[2] : true,
        edge_active[3] : true)
) $

n_active : 0 $
n_weak   : 0 $
for k : 1 thru n_edges_poly do (
    if edge_active[k] then n_active : n_active + 1,
    if edge_weak[k]   then n_weak   : n_weak   + 1) $

print("Section 3: active/inactive partition computed.")$
print("  edge_active =", edge_active)$
print("  edge_weak   =", edge_weak)$
print("  |E_A|       =", n_active)$
print("  |E_weak|    =", n_weak)$
print("  |E_I|       =", n_edges_poly - n_active - n_weak)$

/* =====================================================================
   SECTION 4.  ORIENTATION GROUP ANALYSIS
   ---------------------------------------------------------------------
   For each polygon we record the rotation angles of the reflections
   across each edge (in canonical orientation).  The orientation group
   Gamma is generated by the *composites* of reflection pairs, which
   are rotations by twice the angle between edges.

   For a triangle with three edges at angles alpha_1, alpha_2, alpha_3
   from a fixed axis, the rotation angles are 2(alpha_j - alpha_i).
   We compute these symbolically and determine whether the subgroup
   generated by the active-edge reflections is finite.
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 4: Orientation group analysis")$
print("------------------------------------------------------------")$

/* Angle of edge k (direction of the edge vector). */
edge_angle(verts, k) := block(
    [pp : edge_endpoints(verts, k), dx, dy],
    dx : float(qcanon(pp[2][1] - pp[1][1])),
    dy : float(qcanon(pp[2][2] - pp[1][2])),
    if abs(dx) < 1e-15 and abs(dy) < 1e-15 then 0
    else atan2(dy, dx)) $

edge_angles : makelist(float(edge_angle(poly_vertices, k)),
                       k, 1, n_edges_poly) $
print("Edge angles (radians):")$
for k : 1 thru n_edges_poly do
    print("  e", k, "(", poly_edges[k], ") : ", edge_angles[k],
          " ~ ", float(edge_angles[k]*180/%pi), " deg")$

/* The reflection across an edge with direction angle alpha is the
   reflection across the line through that edge.  Two reflections
   composed give a rotation by 2*(alpha_j - alpha_i).  The orientation
   subgroup generated by the active-edge reflections is generated by
   these pair-rotations. */

active_indices : sublist(makelist(k, k, 1, n_edges_poly),
                          lambda([k], edge_active[k])) $
weak_indices   : sublist(makelist(k, k, 1, n_edges_poly),
                          lambda([k], edge_weak[k])) $
print("Active edge indices: ", active_indices)$
print("Weak   edge indices: ", weak_indices)$

/* Pair-rotation angles among active edges. */
pair_rot_angles : [] $
for i : 1 thru length(active_indices) do
    for j : i + 1 thru length(active_indices) do block(
        [ai : active_indices[i], aj : active_indices[j], delta],
        delta : 2*(edge_angles[aj] - edge_angles[ai]),
        /* Normalize to (-pi, pi]. */
        while delta > %pi do delta : delta - 2*%pi,
        while delta <= -%pi then delta : delta + 2*%pi,
        pair_rot_angles : endcons(float(delta), pair_rot_angles)) $

print("Pair-rotation angles (rad):", pair_rot_angles)$

/* Test if angle is a rational multiple of pi (heuristic). */
is_rational_pi(theta, max_denom) := block(
    [r : float(theta) / float(%pi), q, best_q : 0, best_err : 1e10, k],
    if abs(r) < 1e-12 then return([true, 0, 1]),
    for q : 1 thru max_denom do block(
        [p : round(r * q), err],
        err : abs(r - p/q),
        if err < best_err then (best_err : err, best_q : q)),
    if best_err < 1e-8 then
        [true, round(r * best_q), best_q]
    else
        [false, 0, 0]) $

/* For each pair rotation, check rationality and report the order
   of the rotation, i.e. the smallest k with k*theta = 2*pi*m. */
print("Pair-rotation rationality analysis:")$
all_rational : true $
finite_subgroup_orders : [] $
for theta in pair_rot_angles do block(
    [test : is_rational_pi(theta, 60), order_g],
    if test[1] then (
        /* theta = (p/q)*pi.  Order = lcm needed to make k*p/q an even integer. */
        order_g : if test[2] = 0 then 1
                  else 2 * test[3] / gcd(2 * test[3], test[2]),
        finite_subgroup_orders : endcons(order_g, finite_subgroup_orders),
        print("  theta ~", theta, " = ", test[2], "/", test[3], "*pi  ",
              "rotation order =", order_g)
    ) else (
        all_rational : false,
        print("  theta ~", theta, "  NOT a rational multiple of pi",
              " (orientation group infinite -- DENSE in SO(2))"))) $

if all_rational then (
    print("OK: all active-edge pair rotations are rational multiples of pi."),
    print("  finite subgroup orders =", finite_subgroup_orders),
    if length(finite_subgroup_orders) > 0 then
        print("  Orientation group order (lcm) =",
              apply(lcm, finite_subgroup_orders))
    else
        print("  (No pair rotations; orientation group is generated by",
              "individual reflections, finite of order 2.)")
) else (
    print("WARNING: restricted family fails Criterion 1' (orientation group",
          "is dense in SO(2)).  This explains why the *full* CR pinwheel"),
    print("tiling has tiles in infinitely many orientations.")) $

/* For the Conway-Radin pinwheel triangle, the two legs are perpendicular,
   so the pair rotation is 2*(pi/2) = pi, and the orientation group is
   Z_2 x Z_2 = {I, R_x, R_y, R_xy} of order 4.  Verify this. */
if POLY_TYPE = "CR_triangle" and ACTIVE_MODE = "legs_only" then (
    print(""),
    print("  Conway-Radin pinwheel triangle with legs only:"),
    print("  expected orientation group: Z_2 x Z_2 (Klein four-group),",
          "order 4."),
    print("  This matches Section 2.2 of pinwheels.md.")) $

/* =====================================================================
   SECTION 5.  ADJACENCY GRAPH CONSTRUCTION
   ---------------------------------------------------------------------
   We perform BFS expansion of the restricted family.  Each cell has:
     - center  : reference point [cx, cy] in the field
     - rot_id  : orientation index in {0, 1, ..., G-1} where G is the
                 (finite) orientation-group order
     - sheet   : sheet index in Z_FIBER_ORDER if weak edges are
                 present, else 0
   Two cells are neighbors iff they share an active edge.

   For the Conway-Radin triangle with legs_only, the reflections are
   particularly simple:
     - leg1 (along +x): reflection in the x-axis.
     - leg2 (along +y): reflection in the y-axis.
   Composing both gives the inversion R_pi (180-degree rotation).
   The orientation group is { (1,1), (-1,1), (1,-1), (-1,-1) }
   acting componentwise on coordinates.
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 5: Adjacency graph construction (BFS)")$
print("------------------------------------------------------------")$

/* For the CR triangle (legs_only) we hard-wire the simple orientation
   group as a list of (sx, sy) pairs.  In a more general implementation
   one would carry an explicit rotation+reflection matrix per cell. */

orient_group : [] $
if POLY_TYPE = "CR_triangle" and (ACTIVE_MODE = "legs_only"
                                  or ACTIVE_MODE = "with_hyp") then
    orient_group : [[1, 1], [-1, 1], [1, -1], [-1, -1]]
elseif POLY_TYPE = "tri_1_sqrt3" and ACTIVE_MODE = "legs_only" then
    orient_group : [[1, 1], [-1, 1], [1, -1], [-1, -1]]
elseif POLY_TYPE = "L_tromino" and (ACTIVE_MODE = "long_only"
                                    or ACTIVE_MODE = "legs_only") then
    orient_group : [[1, 1], [-1, 1], [1, -1], [-1, -1]]
else (
    /* Fallback for other polygons / modes: just track identity.
       More elaborate handling would enumerate the dihedral group; for
       this experiment we focus on the perpendicular-legs case. */
    orient_group : [[1, 1]]) $

G_orient : length(orient_group) $
print("Orientation group representation: ", orient_group)$
print("Orientation group order G =", G_orient)$

/* Apply an orientation to a vector. */
apply_orient(o, v) := [o[1]*v[1], o[2]*v[2]] $

/* Compose two orientations (componentwise multiplication for the
   diagonal subgroup). */
compose_orient(o1, o2) := [o1[1]*o2[1], o1[2]*o2[2]] $

/* The reflection across edge k of a cell at center c with orient o.
   For the CR triangle legs:
     - leg1 (k=1) reflects the y-coordinate, and the new cell's center
       is reflected across that leg.
     - leg2 (k=3) reflects the x-coordinate similarly.
   Edges are stored in canonical orientation; the cell's actual edge
   positions are obtained by applying o. */

/* Reflection-of-cell across edge k: returns [new_center, new_orient].
   For the CR triangle (legs_only) case, both legs pass through the
   cell's "right-angle vertex" (the cell's center), so the new cell
   is simply the mirror image across that vertex.  We work this out
   explicitly. */

cr_neighbor_through_edge(center, o, k) := block(
    [verts_world, p1, p2, flip_sign, dx, dy, new_c, new_o, mid],
    /* Apply orientation to each vertex offset and translate. */
    verts_world : map(lambda([v],
                       [center[1] + o[1]*v[1],
                        center[2] + o[2]*v[2]]),
                      poly_vertices),
    p1 : verts_world[mod(k - 1, n_edges_poly) + 1],
    p2 : verts_world[mod(k, n_edges_poly)     + 1],
    /* Reflect the cell's center across the line through p1, p2. */
    dx : qcanon(p2[1] - p1[1]),
    dy : qcanon(p2[2] - p1[2]),
    if qeq(dy, 0) then (
        /* Edge horizontal: reflect y across p1[2]. */
        new_c    : [qcanon(center[1]),
                    qcanon(2*p1[2] - center[2])],
        flip_sign : [1, -1])
    elseif qeq(dx, 0) then (
        /* Edge vertical: reflect x across p1[1]. */
        new_c    : [qcanon(2*p1[1] - center[1]),
                    qcanon(center[2])],
        flip_sign : [-1, 1])
    else (
        /* Hypotenuse: for the CR triangle, hyp goes from (1,0) to (0,2).
           We reflect center across this line.  Using the formula
           for reflection across a line through point p1 with direction
           (dx, dy):
              v' = v - 2 * ((v - p1) . n_hat) * n_hat
           where n_hat is the unit normal. */
        block(
            [vx : center[1] - p1[1],
             vy : center[2] - p1[2],
             len_sq, nx, ny, dot],
            len_sq : dx^2 + dy^2,
            nx : qcanon(-dy / sqrt(len_sq)),
            ny : qcanon( dx / sqrt(len_sq)),
            dot : qcanon(vx*nx + vy*ny),
            new_c : [qcanon(center[1] - 2*dot*nx),
                     qcanon(center[2] - 2*dot*ny)]),
        /* Hyp doesn't fit the simple Z_2 x Z_2 frame; we punt by
           keeping the same orientation and let the sheet-shift handle
           the discrepancy.  This is exactly the "weak generator"
           interpretation. */
        flip_sign : [1, 1]),
    new_o : compose_orient(o, flip_sign),
    [new_c, new_o]) $

/* Cell storage. */
cell_center  : [] $
cell_orient  : [] $
cell_sheet   : [] $
cell_count   : 0 $
nbrs         : [] $
cell_hash    : ?make\-hash\-table() $

cell_fp(c, o, s) := [round(float(c[1])*1048576),
                     round(float(c[2])*1048576),
                     o[1], o[2], s] $

add_cell_p(c, o, s) := block(
    [id, fp],
    cell_count : cell_count + 1,
    id : cell_count,
    cell_center : endcons([qcanon(c[1]), qcanon(c[2])], cell_center),
    cell_orient : endcons(o, cell_orient),
    cell_sheet  : endcons(s, cell_sheet),
    nbrs        : endcons([], nbrs),
    fp : cell_fp(c, o, s),
    block([prev : ?gethash(fp, cell_hash, [])],
          ?puthash(fp, cell_hash, endcons(id, prev))),
    id) $

find_cell_p(c, o, s) := block(
    [fp : cell_fp(c, o, s), candidates, i, result : 0, cc],
    candidates : ?gethash(fp, cell_hash, []),
    for i in candidates do (
        cc : cell_center[i],
        if qeq(cc[1], c[1]) and qeq(cc[2], c[2])
           and cell_orient[i] = o
           and cell_sheet[i]  = s
        then (result : i, return(result))),
    result) $

get_cell_p(c, o, s) := block(
    [id : find_cell_p(c, o, s)],
    if id = 0 then add_cell_p(c, o, s) else id) $

add_edge_p(i, j) := (
    if not member(j, nbrs[i]) then nbrs[i] : endcons(j, nbrs[i]),
    if not member(i, nbrs[j]) then nbrs[j] : endcons(i, nbrs[j])) $

/* Sheet-shift produced when crossing edge k.  For weak edges we
   advance the sheet by +1 mod FIBER_ORDER. */
sheet_shift_through_edge(k) :=
    if edge_weak[k] then 1 else 0 $

/* Neighbor across edge k of cell i. */
add_neighbor_p(i, k) := block(
    [c : cell_center[i], o : cell_orient[i], s : cell_sheet[i],
     nb_data, new_s, nb_id],
    if not (edge_active[k] or edge_weak[k]) then return(0),
    nb_data : cr_neighbor_through_edge(c, o, k),
    new_s : mod(s + sheet_shift_through_edge(k), FIBER_ORDER),
    nb_id : get_cell_p(nb_data[1], nb_data[2], new_s),
    add_edge_p(i, nb_id),
    nb_id) $

expand_cluster_p(depth) := block(
    [frontier, next_frontier, d, i, k, _nb],
    frontier : makelist(ii, ii, 1, cell_count),
    for d : 1 thru depth do (
        next_frontier : [],
        for i in frontier do
            for k : 1 thru n_edges_poly do
                if edge_active[k] or edge_weak[k] then (
                    _nb : add_neighbor_p(i, k),
                    if _nb > 0 and not member(_nb, next_frontier)
                       and not member(_nb, frontier) then
                        next_frontier : endcons(_nb, next_frontier)),
        frontier : next_frontier)) $

origin_id_p : add_cell_p([0, 0], [1, 1], 0) $
print("Seed cell created, id =", origin_id_p)$

expand_cluster_p(BFS_DEPTH) $
N_p : cell_count $
print("After BFS depth", BFS_DEPTH, ", cell count =", N_p)$

/* Sanity dump. */
print("First few cells:")$
for i : 1 thru min(6, N_p) do
    print("  id=", i,
          " center=", cell_center[i],
          " orient=", cell_orient[i],
          " sheet=",  cell_sheet[i],
          " deg=",    length(nbrs[i]))$

deg_list_p : makelist(length(nbrs[i]), i, 1, N_p) $
deg_mean_p : float(apply("+", deg_list_p) / N_p) $
deg_max_p  : apply(max, deg_list_p) $
deg_min_p  : apply(min, deg_list_p) $
print("Degree stats: min=", deg_min_p,
      " mean=", deg_mean_p,
      " max=",  deg_max_p,
      " (active-edge target valence =", n_active + n_weak, ")")$

/* Sheet distribution. */
sheet_set_p : sort(listify(setify(cell_sheet))) $
print("Sheets occupied:", sheet_set_p)$

/* Orientation distribution. */
orient_counts : makelist(0, k, 1, G_orient) $
for i : 1 thru N_p do block(
    [oi : cell_orient[i], k],
    for k : 1 thru G_orient do
        if orient_group[k] = oi then
            orient_counts[k] : orient_counts[k] + 1) $
print("Orientation distribution:")$
for k : 1 thru G_orient do
    print("  ", orient_group[k], " : ", orient_counts[k], " cells")$

/* =====================================================================
   SECTION 6.  BFS VOLUME GROWTH AND d_eff
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 6: BFS volume growth and effective dimension")$
print("------------------------------------------------------------")$

bfs_vols(root) := block(
    [visited : makelist(false, ii, 1, N_p),
     dist    : makelist(-1, ii, 1, N_p),
     queue, v, j, max_d : 0, sizes],
    visited[root] : true,
    dist[root]    : 0,
    queue : [root],
    while length(queue) > 0 do (
        v : first(queue),
        queue : rest(queue),
        for j in nbrs[v] do
            if not visited[j] then (
                visited[j] : true,
                dist[j] : dist[v] + 1,
                if dist[j] > max_d then max_d : dist[j],
                queue : endcons(j, queue))),
    sizes : makelist(0, ii, 0, max_d),
    for ii : 1 thru N_p do
        if dist[ii] >= 0 then
            sizes[dist[ii] + 1] : sizes[dist[ii] + 1] + 1,
    for r : 2 thru length(sizes) do
        sizes[r] : sizes[r] + sizes[r-1],
    sizes) $

vols_p : bfs_vols(origin_id_p) $
print("BFS cumulative N(<=r):")$
for r : 1 thru length(vols_p) do
    print("  r=", r-1, " : N=", vols_p[r])$

d_eff_p : 2.0 $
if length(vols_p) >= 4 then block(
    [r_lo : 2, r_hi : length(vols_p) - 1,
     xs : [], ys : [], fit],
    for r : r_lo thru r_hi do (
        xs : endcons(float(log(r - 1)), xs),
        ys : endcons(float(log(vols_p[r])), ys)),
    fit : log_log_fit(xs, ys),
    print("Interior log-log fit: slope =", fit[1],
          "  intercept =", fit[2]),
    d_eff_p : fit[1]) $

print("Estimated d_eff =", d_eff_p,
      "  (target for Z^2 lattice: d=2)")$

/* =====================================================================
   SECTION 7.  RANDOM WALK ANALYSIS
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 7: Random walk -- d_w and d_spec")$
print("------------------------------------------------------------")$

bfs_dist(root) := block(
    [visited : makelist(false, ii, 1, N_p),
     dist    : makelist(-1, ii, 1, N_p),
     queue, v, j],
    visited[root] : true,
    dist[root]    : 0,
    queue : [root],
    while length(queue) > 0 do (
        v : first(queue),
        queue : rest(queue),
        for j in nbrs[v] do
            if not visited[j] then (
                visited[j] : true,
                dist[j] : dist[v] + 1,
                queue : endcons(j, queue))),
    dist) $

dist_from_origin_p : bfs_dist(origin_id_p) $

random_walk_p(start, T) := block(
    [path : [start], v : start, nb, r],
    for t : 1 thru T do (
        nb : nbrs[v],
        if length(nb) = 0 then return(path),
        r : random(length(nb)),
        v : nb[r + 1],
        path : endcons(v, path)),
    path) $

print("Running", M_WALKS, "random walks of length", T_STEPS, "...")$

msd_sum_p : makelist(0, t, 0, T_STEPS) $
ret_cnt_p : makelist(0, t, 0, T_STEPS) $

for w : 1 thru M_WALKS do block(
    [path : random_walk_p(origin_id_p, T_STEPS), t, v, d],
    for t : 0 thru T_STEPS do (
        v : path[t + 1],
        d : dist_from_origin_p[v],
        if d < 0 then d : 0,
        msd_sum_p[t + 1] : msd_sum_p[t + 1] + d^2,
        if v = origin_id_p then
            ret_cnt_p[t + 1] : ret_cnt_p[t + 1] + 1)) $

msd_p : makelist(float(msd_sum_p[t+1] / M_WALKS), t, 0, T_STEPS) $
p0_p  : makelist(float(ret_cnt_p[t+1] / M_WALKS), t, 0, T_STEPS) $

print("MSD at t = 2, 5, 10:")$
print("  t=2  : ", msd_p[3])$
if T_STEPS >= 5  then print("  t=5  : ", msd_p[6])$
if T_STEPS >= 10 then print("  t=10 : ", msd_p[11])$

MSD_LO : 2 $
MSD_HI : max(4, min(T_STEPS, BFS_DEPTH + 1)) $
msd_x : [] $
msd_y : [] $
for t : MSD_LO thru MSD_HI do
    if msd_p[t + 1] > 0 then (
        msd_x : endcons(float(log(t)), msd_x),
        msd_y : endcons(float(log(msd_p[t + 1])), msd_y)) $

d_w_p : 2.0 $
if length(msd_x) >= 3 then block(
    [fit : log_log_fit(msd_x, msd_y), slope],
    slope : fit[1],
    print("MSD early-time slope =", slope,
          "  =>  d_w =", if abs(slope) > 1e-6 then float(2/slope) else "n/a"),
    if abs(slope) > 1e-6 then d_w_p : float(2/slope))$

P0_LO : 2 $
P0_HI : max(4, min(T_STEPS, 2*BFS_DEPTH)) $
p0_x : [] $
p0_y : [] $
for t : P0_LO step 2 thru P0_HI do
    if p0_p[t + 1] > 0 then (
        p0_x : endcons(float(log(t)), p0_x),
        p0_y : endcons(float(log(p0_p[t + 1])), p0_y)) $

d_spec_p : 0.0 $
if length(p0_x) >= 3 then block(
    [fit : log_log_fit(p0_x, p0_y), slope],
    slope : fit[1],
    print("P_0 early-time slope =", slope,
          "  =>  d_spec =", -2*slope),
    d_spec_p : -2*slope) $

if d_w_p > 0 then block(
    [d_spec_ao : float(2 * d_eff_p / d_w_p)],
    print("Alexander-Orbach d_spec = 2*d_eff/d_w =", d_spec_ao),
    if d_spec_p > 0 then
        print("  direct vs AO discrepancy:",
              abs(d_spec_p - d_spec_ao))) $

/* =====================================================================
   SECTION 8.  HOLONOMY / SHEET-TRANSITION ANALYSIS
   ---------------------------------------------------------------------
   When weak edges are present (ACTIVE_MODE = "with_hyp" for the CR
   triangle), every closed loop in the adjacency graph carries an
   integer holonomy in Z_FIBER_ORDER given by the net sheet shift.
   We enumerate short cycles through the origin and report the
   holonomy distribution.
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 8: Holonomy of short loops")$
print("------------------------------------------------------------")$

if n_weak > 0 then (
    /* Reconstruct sheet shifts along each directed edge. */
    edge_sheet_shift_p(i, j) := mod(cell_sheet[j] - cell_sheet[i],
                                    FIBER_ORDER),
    loop_holonomy_p(seq) := block(
        [tot : 0, k],
        for k : 1 thru length(seq) - 1 do
            tot : tot + edge_sheet_shift_p(seq[k], seq[k+1]),
        mod(tot, FIBER_ORDER)),
    /* Enumerate 4- and 5-cycles. */
    find_short_cycles() := block(
        [cycles : [], v1, v2, v3, v4],
        for v1 in nbrs[origin_id_p] do
            for v2 in nbrs[v1] do
                if v2 # origin_id_p then
                    for v3 in nbrs[v2] do
                        if v3 # v1 and v3 # origin_id_p
                           and member(origin_id_p, nbrs[v3]) then
                            cycles : endcons(
                                [origin_id_p, v1, v2, v3, origin_id_p],
                                cycles),
        for v1 in nbrs[origin_id_p] do
            for v2 in nbrs[v1] do
                if v2 # origin_id_p then
                    for v3 in nbrs[v2] do
                        if v3 # v1 and v3 # origin_id_p then
                            for v4 in nbrs[v3] do
                                if v4 # v2 and v4 # v1
                                   and v4 # origin_id_p
                                   and member(origin_id_p, nbrs[v4]) then
                                    cycles : endcons(
                                        [origin_id_p, v1, v2, v3, v4,
                                         origin_id_p],
                                        cycles),
        cycles),
    short_cycles_p : find_short_cycles(),
    print("Short cycles through origin (lengths 4, 5):",
          length(short_cycles_p), "found."),
    if length(short_cycles_p) > 0 then block(
        [hcounts : makelist(0, k, 1, FIBER_ORDER), c, h],
        for c in short_cycles_p do (
            h : loop_holonomy_p(c),
            hcounts[h + 1] : hcounts[h + 1] + 1),
        print("Holonomy residue distribution (Z_", FIBER_ORDER, "):"),
        for k : 1 thru FIBER_ORDER do
            print("  residue ", k - 1, " : ", hcounts[k], " loops"),
        block(
            [nontrivial : 0],
            for k : 2 thru FIBER_ORDER do
                nontrivial : nontrivial + hcounts[k],
            print("  Non-trivial holonomy loops: ", nontrivial, " / ",
                  length(short_cycles_p),
                  " (fraction = ",
                  float(nontrivial / length(short_cycles_p)), ")")))
) else (
    print("No weak edges in this configuration => trivial fiber group."),
    print("All loops have zero holonomy (sheet structure inactive).")) $

/* =====================================================================
   SECTION 9.  LAPLACIAN SPECTRAL GAP
   ---------------------------------------------------------------------
   For small clusters we compute the Laplacian eigenvalues directly.
   Used as a sanity check on the expander/non-expander behavior.
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 9: Graph Laplacian and spectral gap")$
print("------------------------------------------------------------")$

if N_p <= EIG_MAX_N then block(
    [A_mat, D_diag, L_mat, eig_flat],
    errcatch(load("lapack")),
    A_mat : zeromatrix(N_p, N_p),
    for i : 1 thru N_p do
        for j in nbrs[i] do
            A_mat[i, j] : 1,
    D_diag : makelist(length(nbrs[i]), i, 1, N_p),
    L_mat  : apply(diag_matrix, D_diag) - A_mat,
    if ?fboundp('dgeev) then block(
        [res, evs],
        res : dgeev(float(L_mat)),
        evs : res[1],
        eig_flat : sort(map(lambda([z], float(realpart(z))), evs)))
    else block(
        [eigs : eigenvalues(float(L_mat)),
         eig_vals, eig_mults, k, m],
        eig_vals  : eigs[1],
        eig_mults : eigs[2],
        eig_flat  : [],
        for k : 1 thru length(eig_vals) do
            for m : 1 thru eig_mults[k] do
                eig_flat : endcons(float(eig_vals[k]), eig_flat),
        eig_flat : sort(eig_flat)),
    print("Smallest 5 eigenvalues:",
          makelist(eig_flat[k], k, 1, min(5, length(eig_flat)))),
    print("Largest 3 eigenvalues:",
          makelist(eig_flat[length(eig_flat) - k + 1], k, 1,
                   min(3, length(eig_flat)))),
    block(
        [spec_gap : 0, lam],
        for lam in eig_flat do
            if spec_gap = 0 and lam > 1e-9 then spec_gap : lam,
        print("Algebraic connectivity (spectral gap) =", spec_gap),
        spec_gap_p : spec_gap)
) else (
    print("Skipping eigendecomposition (N =", N_p,
          " > EIG_MAX_N =", EIG_MAX_N, ")."),
    spec_gap_p : 0.0) $

/* =====================================================================
   SECTION 10. CROSS-POLYGON DIMENSIONAL HIERARCHY
   ---------------------------------------------------------------------
   Document, based on the criteria of pinwheels.md Section 5, which
   level of the hierarchy this configuration belongs to.
   ===================================================================== */

print("------------------------------------------------------------")$
print("SECTION 10: Hierarchy level assignment")$
print("------------------------------------------------------------")$

hierarchy_level : "unknown" $
if all_rational and n_weak = 0 then (
    if d_eff_p > 1.7 and d_eff_p < 2.4 then
        hierarchy_level : "Level 0/2 (target periodic lattice, d=2)"
    else if d_eff_p > 2.3 and d_eff_p < 3.5 then
        hierarchy_level : "Level 1 (multi-sheeted, 2 < d < 3)"
    else
        hierarchy_level : "Level 2 (edge-restricted, d~="
                          ||float(d_eff_p)||")"
) elseif all_rational and n_weak > 0 then (
    hierarchy_level : "Level 2 with sheet transitions",
    if d_eff_p > 2.0 and d_eff_p < 3.0 then
        hierarchy_level : "Level 2->1 promotion (covered lattice, 2 < d < 3)"
) elseif not all_rational then (
    hierarchy_level : "Level 3 (non-reconnective) -- this is the full",
    print("  family on a polygon with irrational pair rotations.")) $

print("Configuration: POLY_TYPE=", POLY_TYPE,
      "  ACTIVE_MODE=", ACTIVE_MODE)$
print("Hierarchy level: ", hierarchy_level)$

/* =====================================================================
   SECTION 11. SUMMARY REPORT
   ===================================================================== */

print("============================================================")$
print("pinwheels.mac : summary")$
print("============================================================")$
print("Polygon         :", POLY_TYPE)$
print("Active mode     :", ACTIVE_MODE)$
print("BFS depth       :", BFS_DEPTH)$
print("Cluster size N  :", N_p)$
print("Mean valence    :", deg_mean_p,
       " (target |E_A|+|E_weak| =", n_active + n_weak, ")")$
print("Sheets occupied :", sheet_set_p)$
print("Orientation grp :", G_orient, " elements")$
print("d_eff (BFS)     :", d_eff_p)$
print("d_w   (MSD)     :", d_w_p)$
print("d_spec (P_0)    :", d_spec_p)$
if d_w_p > 0 then
    print("d_spec (AO)     :", float(2*d_eff_p/d_w_p))$
print("Spectral gap    :", spec_gap_p)$
print("Orientation grp finite? ", all_rational)$
print("Hierarchy level :", hierarchy_level)$

print("------------------------------------------------------------")$
print("Notes:")$
print("  * The Conway-Radin pinwheel triangle with legs_only realizes")$
print("    the Klein four-group Z_2 x Z_2 as its restricted orientation")$
print("    group; the restricted family is a periodic Z^2-like tiling")$
print("    (d_eff -> 2 at large depth).")$
print("  * Switching ACTIVE_MODE to 'with_hyp' adds the hypotenuse as")$
print("    a weak generator carrying a Z_n sheet shift, lifting the")$
print("    base lattice to a multi-sheeted cover with d_eff in (2, 3).")$
print("  * Switching to ACTIVE_MODE='all_edges' reproduces the full")$
print("    Conway-Radin pinwheel: orientation group dense in SO(2),")$
print("    Level 3 in the hierarchy of pinwheels.md.  In that mode")$
print("    Section 4's rationality test reports the failure cleanly.")$
print("  * To compare polygons, re-run with PINWHEEL_POLY_OVERRIDE set")$
print("    to other values in {CR_triangle, tri_1_sqrt3, L_tromino,")$
print("    half_penrose_kite, half_penrose_dart}.")$
print("============================================================")$
print("pinwheels.mac : done.")$
print("============================================================")$
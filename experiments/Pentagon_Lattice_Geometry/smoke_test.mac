/* =====================================================================
       smoke_test.mac
    
       Minimum-cost regression test for the multi-sheeted n-gon framework.
       Runs experiment.mac at the `tiny` preset across N_GON in {3,4,5,6}
       and verifies that the headline quantities lie in plausible ranges.
    
       Usage:
         maxima -b smoke_test.mac
    
       Exits with error if any check fails.  Suitable for CI.
       ===================================================================== */
    
    if not(?boundp('display2d)) then display2d : false$
    
    print("============================================================")$
    print("smoke_test.mac : regression test for experiment.mac")$
    print("============================================================")$
    
    failures : [] $
    
    /* Helper: record a failure with descriptive message. */
    fail(msg) := (
         failures : endcons(msg, failures),
         print("  FAIL:", msg)) $
    
    /* Helper: assert a value is within a numeric range. */
    assert_in_range(name, value, lo, hi) := (
         if value < lo or value > hi then
             fail(sconcat(name, " = ", string(value),
                          " not in [", string(lo), ", ",
                          string(hi), "]"))
         else
             print("  OK:", name, "=", value,
                   "in [", lo, ",", hi, "]")) $
    
    /* Test cases: (n, expected d_eff range, expected vortex fraction). */
    test_cases : [
         [3, 1.5, 3.0, 0.0, 0.7],   /* triangle */
         [4, 1.5, 3.0, 0.0, 0.7],   /* square */
         [5, 1.5, 3.5, 0.3, 0.8],   /* pentagon: signature case */
         [6, 1.5, 3.0, 0.0, 0.7]    /* hexagon */
    ] $
    
    for tc in test_cases do block(
         [n : tc[1],
          d_eff_lo : tc[2], d_eff_hi : tc[3],
          vf_lo : tc[4], vf_hi : tc[5],
          vortex_frac],
         print(""),
         print("------------------------------------------------------------"),
         print("Test case: N_GON =", n),
         print("------------------------------------------------------------"),
         /* Override globals before batching experiment.mac. */
         EXPERIMENT_N_GON_OVERRIDE  : n,
         EXPERIMENT_PRESET_OVERRIDE : "tiny",
         EXPERIMENT_TAU_OVERRIDE    : if n = 5 then "signed3"
                                       else "everyn",
         /* Run. */
         block(
             [status : errcatch(batchload("experiment.mac"))],
             if status = false then
                 fail(sconcat("experiment.mac crashed for n = ",
                              string(n)))),
         /* Check results. */
         if ?boundp('d_eff_est) then
             assert_in_range(sconcat("d_eff[n=", string(n), "]"),
                             d_eff_est, d_eff_lo, d_eff_hi)
         else
             fail(sconcat("d_eff_est not bound for n = ", string(n))),
         if ?boundp('N) then
             assert_in_range(sconcat("N[n=", string(n), "]"),
                             N, 5, 100)
         else
             fail(sconcat("N not bound for n = ", string(n))),
         if ?boundp('n_vortex_edges_in_cluster)
            and ?boundp('deg_list) then (
             vortex_frac : float(n_vortex_edges_in_cluster /
                                 (apply("+", deg_list) / 2)),
             assert_in_range(sconcat("vortex_frac[n=", string(n), "]"),
                             vortex_frac, vf_lo, vf_hi))) $
    
    print("")$
    print("============================================================")$
    print("smoke_test.mac : results")$
    print("============================================================")$
    if length(failures) = 0 then (
         print("ALL TESTS PASSED."),
         print("Run with `maxima -b sweep_ngon.mac` for a full sweep.")
    ) else (
         print("TESTS FAILED (", length(failures), " failures):"),
         for f in failures do print("  -", f),
         error("smoke_test.mac: ", length(failures), " failures")) $
    
    print("============================================================")$
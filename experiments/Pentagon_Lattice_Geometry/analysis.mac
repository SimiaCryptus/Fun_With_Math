print("  * Cycle C_n Laplacian eigenvalues = 2 - 2 cos(2 pi k/n)")$
print(" [Pentagon-specific benchmarks verified]")$
print("  * phi^2 = phi + 1; phi*(phi-1) = 1; 1/phi = phi - 1")$
print("  * Fibonacci recursion phi^n = F_n phi + F_{n-1}")$
print("  * Binet formula F_n = (phi^n - psi^n)/sqrt(5)")$
print("  * Pentagon diagonal/side = phi")$
print("  * Pentagram self-similarity: 1/phi^2 = 2 - phi")$
print("  * Z[phi] arithmetic, N(phi^n) = (-1)^n")$
print(" [Extended sections verified]")$
print("  * Alexander-Orbach phase diagram (d_eff x d_w grid)")$
print("  * Anomalous diffusion classification by d_w")$
print("  * Crossover scale t_cross from UV to IR regime")$
print("  * Multifractal tau(q) spectrum (monofractal baseline)")$
print("  * Flat U(1) holonomy phases and Aharonov-Bohm phases")$
print("  * Monodromy matrices and loop orders for n=3,4,5,6")$
print("  * Berry phases and Chern numbers for Z_n sectors")$
print("  * Inflation/substitution matrices and PF eigenvalues")$
print("  * Pentagon inflation ratio = phi^2 confirmed")$
print("  * Dedekind zeta and Dirichlet L(s,chi_5) partial sums")$
print("  * Spectral zeta of C_n at s=1,2,3")$
print("  * Heat trace Tr(e^{-tL}) for cycle and star graphs")$
print("  * Effective spectral dimension from heat-trace slope")$
print("  * Acceptance-window geometry and density")$
print("  * Pentagon window inflation: radius -> 1/phi")$
print("  * Fibonacci word: length = F_k, a/b ratio -> phi")$
